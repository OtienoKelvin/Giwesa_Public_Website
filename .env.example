# =============================================================================
# GIWESA Solutions — public website environment template
# =============================================================================
# Copy this file to `.env` for local development. Never commit real secrets.
# Production values belong in the hosting provider's environment configuration.

# --- Application -------------------------------------------------------------
NODE_ENV=development
# Public base URL, no trailing slash. Used for canonical URLs, sitemap and
# Open Graph metadata. Must be the real https URL in production.
APP_URL=http://localhost:3000

# --- Database (MySQL 8 / MariaDB) -------------------------------------------
# The public website has its own schema. Do NOT point this at the internal FMS
# database. Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/giwesa_public

# Isolated database used by `pnpm test:integration`. Must end in `_test`.
TEST_DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/giwesa_public_test

# --- Public media ------------------------------------------------------------
# Local upload directory. Uploaded files are sanitised and re-encoded as WebP.
# In production this must be a persistent directory; relative paths resolve from
# the application working directory. The directory is served from /uploads.
MEDIA_ROOT=public/uploads
# Maximum accepted source image size, in bytes (4 MB default here).
MEDIA_MAX_BYTES=4194304

# --- Email notifications (optional) -----------------------------------------
# If these are unset, inquiries and bookings are still persisted. No email is
# sent and the failure is logged without visitor data.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=GIWESA Solutions
# Internal recipient for new inquiry/booking notifications.
NOTIFICATION_EMAIL=info@giwesasolutions.co.ke

# --- Development seed (NEVER use these values in production) ----------------
# `prisma/seed.ts` creates this account only when NODE_ENV is not production.
SEED_ADMIN_EMAIL=admin@giwesa.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=GIWESA Administrator

# --- Deliberate production bootstrap (optional, one-off) --------------------
# In production the seed refuses to create an admin unless BOTH of these are
# explicitly supplied. Remove them after the first sign-in and change the
# password immediately. There is no default production password.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=GIWESA Administrator
